{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(python -m json.tool*)",
      "Bash(python -m pytest*)",
      "Bash(py -m pytest*)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios show 7a96c95:src/scripts/character/character_system.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios status)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios diff --stat)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios diff .claude/settings.json)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add production/session-state/active.md production/milestones/milestone-beta.md production/risk-register/active.md production/sprints/sprint-007.md production/project-stage-report.md)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios commit -m ' *)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add production/sprints/sprint-008.md production/epics/index.md production/qa/polish-fixlist-2026-05-25.md)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add src/scripts/ui/main_menu.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios status -s)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add src/scripts/ui/exploration_panel.gd src/scripts/ui/main_menu.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add src/scripts/ui/exploration_panel.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add src/scripts/combat/combat_manager.gd src/scripts/character/character_system.gd project.godot src/scripts/ui/exploration_panel.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add project.godot src/scripts/ui/equipment_ui.gd src/scripts/character/character_system.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add src/scripts/ui/combat_action_panel.gd)",
      "Bash(git -C /Users/lingang/Downloads/workspace/shanlei_game/Claude-Code-Game-Studios add src/scripts/core/game_loop_manager.gd src/scripts/ui/exploration_panel.gd src/scripts/fast_travel/fast_travel_manager.gd)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(*>.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/detect-gaps.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-commit.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-push.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-assets.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-skill-change.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-agent.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-agent-stop.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  }
}
