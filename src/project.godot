; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="武侠奇遇录"
config/description="一款深度武侠RPG游戏"
run/main_scene="res://scenes/main_game_ui.tscn"
config/features=PackedStringArray("4.6")
config/main_scene="res://scenes/main_game_ui.tscn"

[autoload]

CharacterSystem="res://scripts/character/character_system.gd"
CombatSystem="res://scripts/combat/combat_system.gd"
ExperienceSystem="res://scripts/experience/experience_system.gd"
EquipmentSystem="res://scripts/equipment/equipment_system.gd"
EncounterSystem="res://scripts/encounter/encounter_system.gd"
UIManager="res://scripts/ui/ui_manager.gd"
SaveSystem="res://scripts/save/save_system.gd"
AudioSystem="res://scripts/audio/audio_system.gd"
QuestSystem="res://scripts/quest/quest_system.gd"
WorldSystem="res://scripts/world/world_system.gd"
EconomySystem="res://scripts/economy/economy_system.gd"
GameData="res://scripts/core/game_data.gd"
DatabaseManager="res://scripts/database/database_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
