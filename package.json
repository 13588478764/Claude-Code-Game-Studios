{
  "name": "wlb-game",
  "version": "0.1.0",
  "private": true,
  "description": "打工轮回 - Roguelike work simulator mini-program game",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "dev:mp-alipay": "uni -p mp-alipay",
    "validate:events": "tsx tools/validate-events.ts",
    "build:h5": "npm run validate:events && uni build",
    "build:mp-weixin": "npm run validate:events && uni build -p mp-weixin",
    "build:mp-toutiao": "npm run validate:events && uni build -p mp-toutiao",
    "build:mp-alipay": "npm run validate:events && uni build -p mp-alipay",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4030620241128001",
    "@dcloudio/uni-mp-alipay": "3.0.0-4030620241128001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-4030620241128001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4030620241128001",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4030620241128001",
    "@dcloudio/uni-cli-shared": "3.0.0-4030620241128001",
    "@dcloudio/uni-h5": "^3.0.0-4030620241128001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4030620241128001",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^1.5.0",
    "@vue/test-utils": "^2.4.5",
    "happy-dom": "^14.7.1",
    "tsx": "^4.22.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.5.0",
    "vue-tsc": "^2.0.13"
  }
}
