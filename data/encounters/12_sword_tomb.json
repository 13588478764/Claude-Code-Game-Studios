{
  "id": "encounter_12_sword_tomb",
  "title": "剑冢遗迹",
  "description": "在中原剑山区域探索时，发现一处古老的剑修埋骨之地，残剑林立，剑气弥漫",
  "type": "exploration",
  "probability": 0.06,
  "trigger_conditions": {
    "region": "zhongyuan_sword_mountain",
